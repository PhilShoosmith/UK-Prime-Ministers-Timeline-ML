rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidHallOfFameEntry(data) {
      return data.keys().hasAll(['name', 'score', 'time_left', 'game_mode', 'date']) &&
             data.keys().size() == 5 &&
             data.name is string && data.name.size() <= 100 &&
             data.score is number &&
             data.time_left is number &&
             data.game_mode is string && (data.game_mode == 'year' || data.game_mode == 'pm' || data.game_mode == 'fact') &&
             data.date is string;
    }

    match /hall_of_fame/{entryId} {
      allow read: if true; // Public leaderboard
      allow create: if isValidId(entryId) && isValidHallOfFameEntry(request.resource.data);
    }
  }
}
